{
  "schemaVersion": 1,
  "id": "mahjongcraft",
  "version": "${version}",
  "name": "MahjongCraft",
  "description": "Play Japanese (Riichi) Mahjong with your friends, plus Yu-Gi-Oh! and Pokemon TCG card games at the Game Table. The card games use real cards downloaded on your own server for private play; not affiliated with Konami, Nintendo, The Pokemon Company or Creatures.",
  "authors": [
    "doublemoon1119"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/mahjongcraft",
    "sources": "https://github.com/doublemoon1119/MahjongCraft",
    "issues": "https://github.com/doublemoon1119/MahjongCraft/issues"
  },
  "license": "MIT",
  "icon": "assets/mahjongcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "doublemoon.mahjongcraft.MahjongCraft"
      },
      "com.tablecards.TableCardsMod"
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "doublemoon.mahjongcraft.MahjongCraftClient"
      },
      "com.tablecards.client.TableCardsClient"
    ],
    "modmenu": [
      "doublemoon.mahjongcraft.client.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.2",
    "fabric": "*",
    "minecraft": ">=1.21.1",
    "fabric-language-kotlin": "*",
    "cloth-config2": ">=15.0.130"
  }
}
